# Copy to terraform.tfvars (gitignored) and fill in. Nothing here is a secret — it is left out of version control
# because it is per-operator, not per-project: the next person has their own IP and their own Entra identity.

# curl ifconfig.me — refresh this when your ISP reassigns you an address; see
# docs/dbeaver-azure-connection.html, "Zanim zadzwonisz, że nie działa".
developer_ip_address = "203.0.113.10"

# az ad signed-in-user show --query "{id:id, upn:userPrincipalName}"
postgres_admin_object_id = "00000000-0000-0000-0000-000000000000"
postgres_admin_upn       = "you@example.com"

# The same `id` as above today — the operator and the database administrator are one person here. Named separately
# because they are different jobs, and because this one must never be inferred from whoever ran Terraform.
operator_object_id = "00000000-0000-0000-0000-000000000000"

# Where the alerts in infra/monitoring.tf go.
operator_email = "you@example.com"

# The agent's model catalogue has a working default in variables.tf. Override it only to change which models the agent
# offers, confirming each against OpenAI's own list, since nothing here checks it. The key is not a variable at all.

# Leave false until the three Telegram account secrets are in Key Vault. False is a working configuration: the
# gateway sends, and refuses to create bots naming the settings it wants.
telegram_account_session_configured = false

# The name the workbench's post archive and strategy send their alerts to, bound in the gateway by hand. Empty leaves both silent,
# which is a working configuration and the rollback lever.
telegram_alert_destination = ""
