{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -ExecutionPolicy Bypass -File \".claude/hooks/require-review.ps1\"",
            "timeout": 15,
            "statusMessage": "Checking the change has been reviewed"
          }
        ]
      }
    ]
  }
}
