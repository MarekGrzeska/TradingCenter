# `modules/terminal/scripts/contract.mjs` writes this file with LF, and `pnpm
# contract:check` compares it byte for byte against a fresh generation. Git's Windows
# default (`core.autocrlf=true`) hands the checkout CRLF instead, so the check reports a
# stale contract on a clean clone — on a machine where nothing is stale. Pinned to LF so
# the working copy matches what the generator writes.
modules/terminal/src/data/contract.generated.ts text eol=lf
# Same for teams' own generated contract — added when a fresh checkout on Windows
# reported it stale for exactly this reason, one group after the file appeared.
modules/terminal/src/data/contract.teams.generated.ts text eol=lf

# Every generated contract, on both screens, for the reason above: only two were pinned, and the other seven showed up
# as modified with an empty diff after every regeneration (found by the contract-sync skill, 23 September 2026).
modules/*/src/data/*.generated.ts text eol=lf

# Shell scripts run under bash, which fails on a CRLF checkout: every line ends in a stray carriage return.
*.sh text eol=lf
