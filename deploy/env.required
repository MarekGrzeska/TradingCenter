# The names `.env` on the server must hold, one per line, and nothing else: a name missing from the GitHub Secrets of the
# environment `vps` stops the deploy before anything is pulled, and the compose file refuses to start without them too.
# Not here: the image tags (`tags.env`, written by the deploy itself) and the optional ones docker-compose.yml defaults
# to blank — ALERT_DESTINATION, TELEGRAM_API_ID, TELEGRAM_API_HASH, TELEGRAM_SESSION.
# `scripts/tests/test_deploy_compose.py` keeps this list and the compose file saying the same thing.

# The four names the edge answers on, and where its certificates are reported.
API_HOST
GATEWAY_HOST
TERMINAL_HOST
POCKET_HOST
ACME_EMAIL
IMAGE_PREFIX

# Entra: the tenant, the audiences each API accepts (both spellings of one API, comma-separated), and the applications
# the records admit.
ENTRA_TENANT_ID
WORKBENCH_ENTRA_AUDIENCES
GATEWAY_ENTRA_AUDIENCES
TERMINAL_APPLICATION_ID
POCKET_APPLICATION_ID

# The database: the server's own superuser (used only to create roles) and one password per role.
POSTGRES_PASSWORD
AGENT_DB_PASSWORD
TEAMS_DB_PASSWORD
MARKET_DB_PASSWORD
POLYMARKET_DB_PASSWORD
SOCIAL_DB_PASSWORD
STRATEGY_DB_PASSWORD
TELEGRAM_DB_PASSWORD
YOUTUBE_DB_PASSWORD

# The one key the system's services show one another, and capital.com's demo credentials.
GATEWAY_API_KEY
CAPITAL_API_KEY
CAPITAL_IDENTIFIER
CAPITAL_PASSWORD

# The model providers and the catalogues (JSON).
AGENT_OPENAI_API_KEY
TEAMS_OPENAI_API_KEY
AGENT_MODELS
TEAMS_MODELS
AGENT_DEFAULT_MODEL_ID
YOUTUBE_DATA_API_KEY
YOUTUBE_GEMINI_API_KEY
