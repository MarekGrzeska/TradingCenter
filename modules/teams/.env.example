# This module's own storage — the local container in ../../compose.yaml, a third
# logical database alongside `market_data` and `agent` (dev.sh/dev.ps1 create `teams`
# inside it on first run, the same way they already create `agent`).
#
# DATABASE_USER left unset is what selects local mode — without an identity, config.py
# refuses any remote host, production included. The remote shape (identity, TLS, no
# password in the URL) is production's, set by infra/app-service.tf.
DATABASE_URL=postgresql://teams:change-me@127.0.0.1:55432/teams
DATABASE_USER=

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# OpenAI, this module's only model provider. The key is the only credential it accepts —
# there is no managed-identity mode here the way there is for the database, because
# OpenAI is not in Entra and has nobody to present an Entra token to. Deliberately a key
# of this module's own, not shared with `agent` — in Azure this arrives as a Key Vault
# reference to `teams-openai-api-key` (infra/key-vault.tf), a separate secret from
# agent's `openai-api-key`, so the cost of these experiments shows up on its own line.
OPENAI_API_KEY=

# The models an agent in a team can be assigned, as a JSON array. `id` is this module's
# own stable identifier (carried in every team revision and usage row); `model` is what
# OpenAI is asked for, kept separate because an id outlives a model renamed or retired
# upstream. Rates are per 1,000,000 tokens — the unit OpenAI's own pricing page quotes,
# so a rate is copied across without arithmetic in either direction. Confirm current
# rates before deploying: they move faster than this module does. Unlike agent, there is
# no DEFAULT_MODEL_ID — every agent in a saved team revision must name its own model.
MODELS=[{"id":"gpt-5.6-luna","model":"gpt-5.6-luna","display_name":"Luna","cost_rank":1,"input_rate_per_1m":"0.2","output_rate_per_1m":"1.2"},{"id":"gpt-5.6-terra","model":"gpt-5.6-terra","display_name":"Terra","cost_rank":2,"input_rate_per_1m":"2","output_rate_per_1m":"12"},{"id":"gpt-5.6-sol","model":"gpt-5.6-sol","display_name":"Sol","cost_rank":3,"input_rate_per_1m":"5","output_rate_per_1m":"30"}]

# market-mcp, the tool server that reads. Left unset, a team whose agents carry no
# assigned tools still runs; a team that does assign tools is refused at run time rather
# than left to guess. MARKET_MCP_SCOPE is set only when the URL points off this machine
# (api://<market-mcp-app-id>/.default); a scope against loopback is refused at startup,
# and so is a remote URL without one.
MARKET_MCP_URL=http://127.0.0.1:8040
MARKET_MCP_SCOPE=
MARKET_MCP_REQUEST_TIMEOUT_SECONDS=15

# trading-mcp, the tool server that writes — the same three settings, checked
# independently. Leaving these unset is a supported state and not a lesser one: it is what
# this module was for the whole of phase 1, and a team given only reading tools never
# notices. What it is not is a quiet one — a team assigning an order tool is refused at
# run time, by name.
TRADING_MCP_URL=http://127.0.0.1:8060
TRADING_MCP_SCOPE=
TRADING_MCP_REQUEST_TIMEOUT_SECONDS=35

# How long one run may take before it is stopped with the time limit named as the reason.
# The whole run, not one agent — several of them work in it, some at the same time. The
# per-agent ceiling on model-tool rounds is not configurable and lives in the code
# (teams/runner/loop.py), because a safety ceiling in a settings file is an invitation to
# raise it at the moment it is inconvenient.
RUN_TIMEOUT_SECONDS=900

# Whether something stands in front of this module and authenticates callers (Easy
# Auth, in Azure). Off locally, where nothing stands in front and there is no identity
# to have.
REQUIRE_AUTHENTICATED_PRINCIPAL=false

# The module's own clock — a schedule or trigger firing on its own, from a task in this
# process's `lifespan`, not from anything in Azure. SCHEDULER_ENABLED=false turns it off
# without a redeploy: every schedule and trigger stays exactly where it was, and a run
# started by hand still works. SCHEDULER_FAILURE_THRESHOLD is how many consecutive
# failed runs a schedule or trigger tolerates before it disables itself.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_SECONDS=15
SCHEDULER_FAILURE_THRESHOLD=3

# How much this module says. INFO by default; WARNING to turn it down without a deploy.
LOG_LEVEL=INFO
