# Copy to .env. The defaults match compose.yaml, so a fresh checkout needs no further edit —
# except the three account-session lines, which are meant to stay empty until you want them.

# Local mode: DATABASE_USER unset, and the URL must be loopback. Production sets DATABASE_USER to the
# app's own role and the credential becomes an Entra token fetched per connection.
DATABASE_URL=postgresql://telegram:change-me@127.0.0.1:55432/telegram
DATABASE_USER=

# Identity mode only, and unset even there when running in Azure — the App Service's
# system-assigned managed identity needs no configuration.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Telegram's bot surface. Set here rather than left to the module's default for the reason every other
# upstream address is: a default that changed under a dependency bump would move it with nothing to say so.
BOT_API_BASE_URL=https://api.telegram.org

# **These three empty is a working configuration, not a missing step.** Creating a bot means talking to
# Telegram's creator bot, and only a user account may — so this is a credential to your personal Telegram
# account. Without them the module sends normally and refuses to create bots, naming what is missing.
# With them, `POST /bots` creates one. Give all three or none: two of the three is refused at startup.
# TELEGRAM_API_ID and TELEGRAM_API_HASH come from my.telegram.org; TELEGRAM_SESSION is a session string.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Telegram's own ceiling on bots per account. Checked before the module speaks to the creator bot,
# because a refusal after the fact still costs an attempt counted against the account.
MAX_BOTS=20

# Telegram refuses a longer message. The module refuses it too, rather than truncating: a shortened
# alert is an alert about something else, and nothing in a 2xx response would say so.
MAX_MESSAGE_CHARS=4096

# Four, not the pool default of ten. Seven logical databases share one B_Standard_B1ms whose
# max_connections is 35, and this module's work is one HTTP call per message, not a query per row.
DATABASE_POOL_SIZE=4

# Whether something stands in front of this module and authenticates callers (Easy Auth,
# in Azure). Off locally, where nothing stands in front and there is no identity to have.
REQUIRE_AUTHENTICATED_PRINCIPAL=false

# Which caller reaches which surface, by the token's application id. Comma-separated. Empty locally,
# where the line above is off. The split is not reading from writing — both surfaces send — but that
# creating a bot and binding a destination are REST alone.
TOOL_CALLER_APPLICATION_IDS=
REST_CALLER_APPLICATION_IDS=
