# Where the prediction-market archive answers — the workbench, under /polymarket. A relative path goes through Vite's proxy in dev and
# through whatever fronts the app in production; an absolute URL bypasses both.
VITE_POLYMARKET_HTTP=/polymarket-api


# The workbench, which is where the conversation lives — the browser never speaks MCP itself.
VITE_WORKBENCH_HTTP=/workbench-api
WORKBENCH_PROXY_TARGET=http://localhost:8030
