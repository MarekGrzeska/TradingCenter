# The feed this module's one source reads. A setting rather than a constant because it is somebody's side project:
# the day it moves, that is a deployment, not a release.
TRUTH_SOCIAL_FEED_URL=https://www.trumpstruth.org/feed

# How this module names itself upstream. Not politeness: an edge selecting on this header refuses some library
# defaults outright, and a refusal reads from here as an empty feed.
PROVIDER_USER_AGENT=tradingcenter-social-data/0.1 (+https://github.com/MarekGrzeska)
PROVIDER_TIMEOUT_SECONDS=20

# The archive's own storage — the local container in ../../compose.yaml, whose role and database `scripts/dev.py`
# creates if missing. DATABASE_USER left unset selects local mode, which config.py narrows to loopback.
DATABASE_URL=postgresql://social:change-me@127.0.0.1:55432/social
DATABASE_USER=

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Seconds between passes over the feed, and how far back one pass looks. Posts arrive in bursts and the feed answers
# per date, so this is minutes rather than the candle archive's seconds.
COLLECT_INTERVAL_SECONDS=300
COLLECT_WINDOW_HOURS=24

# Passes without a successful collection before the archive calls itself stale, on the screens and in the tool that
# answers what it is doing. Five minutes of silence is a slow feed; half an hour of it is worth saying.
STALE_AFTER_TICKS=6

# The model, and the two jobs it does — translation into Polish and the market-impact reading. **Leaving the key
# empty is a supported state**: the module collects, every reading stays empty, and /state says why. Locally that
# is the usual setting; in production the deployment reads the workbench's own key out of Key Vault, so the
# readings arrive on the same line of the bill as the conversation (infra/app-service.tf).
OPENAI_API_KEY=
OPENAI_BASE_URL=
TRANSLATION_MODEL=gpt-5.6-luna
ANALYSIS_MODEL=gpt-5.6-terra

# How many posts one pass may enrich. A busy day has to cost a bounded amount; the rest waits for the next pass.
ENRICHMENT_BATCH_LIMIT=20

# The door to Telegram, and **all three empty is a working configuration**: the module collects and reads exactly
# as before, tells nobody, and /state says which of the two it is. Set together — an address with no destination
# has nowhere to send. The destination is a name the operator bound in the gateway, never a chat id. The scope is
# for a gateway off this machine, where Easy Auth refuses a request carrying no token; on loopback, leave it empty.
TELEGRAM_GATEWAY_URL=
TELEGRAM_GATEWAY_SCOPE=
ALERT_DESTINATION=

# How impactful a post must be before it is worth waking somebody. The reading is 1..10; eight rather than five
# because the operator reads every one of these on a phone, and a channel that speaks daily is one nobody looks at.
ALERT_MIN_IMPACT_SCORE=8

# Whether something stands in front of this module and authenticates callers (Easy Auth,
# in Azure). Off locally, where nothing stands in front and there is no identity to have.
REQUIRE_AUTHENTICATED_PRINCIPAL=false

# Who may reach which surface once the layer in front has let them in. Easy Auth authorizes an application, not a
# route, and both surfaces stand in one process — so an empty list here refuses, and refusing is the safe reading.
TOOL_CALLER_APPLICATION_IDS=
REST_CALLER_APPLICATION_IDS=

# How much this module says. Nothing else sets a level or a destination for the root
# logger — uvicorn configures only its own three. INFO by default.
LOG_LEVEL=INFO
