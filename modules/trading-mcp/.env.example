# Where capital-gateway is listening.
CAPITAL_GATEWAY_URL=http://127.0.0.1:8010

# capital-gateway's own caller key (its GATEWAY_API_KEY, sent as X-Gateway-Key).
# Required at every address, loopback included — the gateway checks it on every
# caller regardless of where this module runs. See config.py's docstring.
CAPITAL_GATEWAY_API_KEY=

CAPITAL_GATEWAY_REQUEST_TIMEOUT_SECONDS=30
TRADING_MCP_PORT=8060
# Loopback locally. The container sets 0.0.0.0 (Dockerfile) because the platform
# reaches it from outside; a desk has no reason to publish trading tools to its network.
TRADING_MCP_HOST=127.0.0.1

# Whether a platform authenticator (Easy Auth) stands in front of this module —
# see config.py's docstring. False locally, where nothing stands in front; true in
# Azure (infra/app-service.tf).
REQUIRE_AUTHENTICATED_PRINCIPAL=false
