          "resolution"
        ],
        "title": "Candle",
        "type": "object"
      },
      "CandleHistory": {
        "description": "A deep read, with what it cost.\n\nThe provider serves at most 1000 candles per request, so a deep read is many\nrequests and can take tens of seconds. ``requests`` makes that visible instead of\nleaving a caller to guess why a read was slow, and ``history_ended`` distinguishes\n\"the instrument has no more data\" from \"we stopped early\" \u2014 both of which otherwise\nlook identical: a series shorter than the one asked for.",
        "properties": {
          "candles": {
            "items": {
              "$ref": "#/components/schemas/Candle"
            },
            "title": "Candles",
            "type": "array"
          },
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "first_ts": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Ts"
          },
          "history_ended": {
            "default": false,
            "title": "History Ended",
            "type": "boolean"
          },
          "last_ts": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Ts"
          },
          "requested": {
            "title": "Requested",
            "type": "integer"
          },
          "requests": {
            "title": "Requests",
            "type": "integer"
          },
          "resolution": {
            "$ref": "#/components/schemas/Resolution"
          }
        },
        "required": [
          "candles",
          "count",
          "requested",
          "requests",
          "resolution"
        ],
        "title": "CandleHistory",
        "type": "object"
      },
