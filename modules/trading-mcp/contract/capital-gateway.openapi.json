  "info": {
    "description": "capital.com gateway \u2014 trading, deep history and a live stream behind one contract. Demo environment only. Endpoints return neutral DTOs; provider quirks (session tokens, the instrument tree, asynchronous settlement) stay inside the adapter. The WebSocket at /ws/stream is not described by this schema \u2014 see the module README.",
    "title": "TradingCenter \u00b7 capital-gateway",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "The health probe. The one route reachable with no caller key, so it MUST NOT\nsay anything beyond \"this process is up\" \u2014 no account, no session state, no route\nlist, nothing a caller couldn't already have inferred by finding the module.",
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Root  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root",
        "tags": [
          "meta"
        ]
      }
    },
    "/accounts": {
      "get": {
        "operationId": "accounts_accounts_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Account"
                  },
                  "title": "Response Accounts Accounts Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Accounts",
        "tags": [
          "accounts"
        ]
      }
    },
    "/accounts/active": {
      "put": {
        "description": "Switch the active account. Positions and orders act on it afterwards.",
        "operationId": "set_active_account_accounts_active_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetActiveAccount"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Set Active Account",
        "tags": [
          "accounts"
        ]
      }
    },
    "/asset-classes": {
      "get": {
        "description": "The classes this module describes instruments with.\n\nPublished so a consumer offering a choice of class does not carry its own copy of\nthe list \u2014 a copy is a thing that drifts, and it drifts silently.",
        "operationId": "asset_classes_asset_classes_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AssetClass"
                  },
                  "title": "Response Asset Classes Asset Classes Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Asset Classes",
        "tags": [
          "market-data"
        ]
      }
    },
    "/capabilities": {
      "get": {
        "description": "What this module serves, and which environment it is bound to.",
        "operationId": "capabilities_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Capabilities",
        "tags": [
          "meta"
        ]
      }
    },
    "/instruments": {
      "get": {
        "description": "Every instrument, deduped. `truncated` is true when the bound cut the walk short.",
        "operationId": "instruments_instruments_get",
        "parameters": [
          {
            "description": "how much of the tree to walk; defaults higher when asset_class is set",
            "in": "query",
            "name": "max_nodes",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 5000,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "how much of the tree to walk; defaults higher when asset_class is set",
              "title": "Max Nodes"
            }
          },
          {
            "description": "narrow to one class, e.g. 'CRYPTO'; see GET /asset-classes",
            "in": "query",
            "name": "asset_class",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "narrow to one class, e.g. 'CRYPTO'; see GET /asset-classes",
              "title": "Asset Class"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstrumentPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Instruments",
        "tags": [
          "market-data"
        ]
      }
    },
    "/instruments/search": {
      "get": {
        "operationId": "search_instruments_instruments_search_get",
        "parameters": [
          {
            "description": "e.g. 'gold', 'apple', 'btc'",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "e.g. 'gold', 'apple', 'btc'",
              "title": "Q",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Instrument"
                  },
                  "title": "Response Search Instruments Instruments Search Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Instruments",
        "tags": [
          "market-data"
        ]
      }
    },
    "/instruments/{symbol}/candles": {
      "get": {
        "description": "One request's worth of candles. For more than 1000, use `/history`.",
        "operationId": "candles_instruments__symbol__candles_get",
        "parameters": [
          {
            "in": "path",
            "name": "symbol",
            "required": true,
            "schema": {
              "title": "Symbol",
              "type": "string"
            }
          },
          {
            "description": "candle time frame",
            "in": "query",
            "name": "resolution",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Resolution",
              "default": "MINUTE",
              "description": "candle time frame"
            }
          },
          {
            "description": "the provider's ceiling is 1000",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
