        "description": "One candle, built from the **bid** side. The stream uses the same side, which is\nwhat lets history and live data be joined without a step at the seam.",
        "properties": {
          "close": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Close"
          },
          "forming": {
            "default": false,
            "title": "Forming",
            "type": "boolean"
          },
          "high": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "High"
          },
          "low": {
            "anyOf": [
              {
                "type": "number"
              },
