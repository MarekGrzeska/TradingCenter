# Copy to .env. This file is the list — a setting absent from here is a setting this
# module does not read.

# --- the archive, this module's only upstream -----------------------------------------
#
# The REST contract, not the tool surface at /mcp: that one is narrowed for a model — ten indicators a call, two
# hundred points a series — which is right for an agent and too tight for a loop.
MARKET_DATA_URL=http://127.0.0.1:8020
# The archive's audience, when this module presents an identity of its own. Absent is the local configuration, since
# there is no directory here to get a token from. In Azure: api://tradingcenter-market-data/.default
# MARKET_DATA_SCOPE=
MARKET_DATA_REQUEST_TIMEOUT_SECONDS=30

# --- this module's own database -------------------------------------------------------
#
# Local: the compose.yaml container, with DATABASE_USER unset — which selects local mode, and local mode refuses any
# host but loopback, so a URL aimed at production is a startup error rather than a quiet write.
DATABASE_URL=postgresql://strategy:change-me@127.0.0.1:55432/strategy
# DATABASE_USER=

# How many connections this module may hold at once. Seven logical databases share one
# B_Standard_B1ms whose max_connections is 35, so the numbers across the modules are one budget:
# scripts/tests/test_pool_budget.py adds them up and refuses a total above 30.
DATABASE_POOL_SIZE=3
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=

# --- the loop -------------------------------------------------------------------------
#
# How often the loop wakes to ask whether a new bar has closed. Not the resolution it decides on: waking more
# often than the bar closes costs one cheap query finding nothing.
EVALUATION_INTERVAL_SECONDS=60

# --- telling the operator -------------------------------------------------------------
#
# **All three empty is a working configuration**: the platform evaluates and records decisions exactly as it does
# now, and says nothing. Set together — the gateway addresses by a name the operator bound in it, never by a chat
# id. The scope is for a gateway off this machine, where Easy Auth refuses a request carrying no token; leave it
# empty on loopback. Only a decision naming a trade is announced, and only when it changes.
TELEGRAM_GATEWAY_URL=
TELEGRAM_GATEWAY_SCOPE=
ALERT_DESTINATION=

# --- who may reach which surface ------------------------------------------------------
#
# Off locally, where nothing stands in front and there is no identity to have. On in Azure, where the two lists
# below are read.
REQUIRE_AUTHENTICATED_PRINCIPAL=false
# The workbench's application id — its triggers read pending_setups at /mcp.
TOOL_CALLER_APPLICATION_IDS=
# The terminal's, for the REST contract.
REST_CALLER_APPLICATION_IDS=

LOG_LEVEL=INFO
