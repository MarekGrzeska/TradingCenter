# capital.com DEMO credentials. Create the key in the demo account's API settings —
# a live key will not work here, because the module refuses to start outside demo.
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=your-login-email
CAPITAL_PASSWORD=

# A slot, read by nothing yet, for a question worth measuring: whether two API keys under one login are two sessions.
# What is known is narrower — logging in with *the same* credentials kills the previous one, which is why two gateway
# processes deauthenticate each other. If they are independent, `live` tests stop needing a second registration.
CAPITAL_API_KEY_SECONDARY=

# The second key's own password: `POST /session` takes the API key's custom password, not the account's, so two keys
# have two of them (measured 10 August — the wrong one answers `error.invalid.details`). Empty reuses CAPITAL_PASSWORD.
CAPITAL_PASSWORD_SECONDARY=

# Both endpoints are checked at startup and must match exactly. They are here to be
# read, not changed — any other value refuses to start.
CAPITAL_BASE_URL=https://demo-api-capital.backend-capital.com
CAPITAL_STREAM_URL=wss://api-streaming-capital.backend-capital.com/connect

# This module's own caller key, not a capital.com credential: every caller presents it in X-Gateway-Key or is refused
# before capital.com is touched. Any value works locally as long as market-data's `.env` matches; Azure reads Key Vault.
GATEWAY_API_KEY=

# Set to exactly "production" in the deployed environment, where the module then publishes no /docs and no
# /openapi.json — a published schema hands anyone the exact shape of /orders — and where the key above opens no
# HTTP route: the application a platform-validated token names decides instead, from the two lists below.
GATEWAY_ENV=

# JSON lists of application ids, filled by Terraform and empty locally, where nothing stands in front to name a
# caller. Modules reach every route; browsers the account only. Empty means nobody, never everybody.
MODULE_CALLER_APPLICATION_IDS=
BROWSER_CALLER_APPLICATION_IDS=
