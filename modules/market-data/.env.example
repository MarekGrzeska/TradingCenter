# capital-gateway, this module's only upstream. Pointing either of these at capital.com
# is refused at startup — the gateway owns the single rate gate and the demo-only guard.
GATEWAY_BASE_URL=http://localhost:8010
GATEWAY_STREAM_URL=ws://localhost:8010/ws/stream

# capital-gateway is not public — every request and every stream handshake must carry
# this, or the gateway answers 401 before capital.com is touched. Must match that
# module's own GATEWAY_API_KEY exactly. Required: a module started without it would run
# and archive nothing, and the gap would surface as silence hours later, not as a
# refusal now.
GATEWAY_API_KEY=

# The archive's own storage — the local container in ../../compose.yaml
# (openspec/changes/local-dev-database-in-docker). The credentials below match that file
# exactly, so a fresh checkout needs no edit here; they are development credentials for a
# database bound to loopback, not a secret.
#
# DATABASE_USER left unset is what selects this local mode — and it narrows the module to
# loopback: without an identity, config.py refuses any remote host, production included.
# The remote shape (identity, TLS, no password in the URL) is production's, set by
# infra/app-service.tf; the three AZURE_* variables below belong to that mode and stay
# empty here.
DATABASE_URL=postgresql://market_data:change-me@127.0.0.1:55432/market_data
DATABASE_USER=

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# How much of the provider's 10 req/s allowance this module may take. One deep fill at a
# time, because two of them together starve the chart someone is looking at right now.
BACKFILL_CONCURRENCY=1

# How far back a newly tracked pair reaches on its first fill, in candles.
DEFAULT_BACKFILL_BARS=5000

# The gateway holds one provider connection per tracked pair and the provider limits how
# many a session may hold. Raise this on evidence, not on hope. A pair is one (symbol,
# resolution), so one instrument on all eight time frames spends eight of these.
MAX_TRACKED_PAIRS=160

# How a browser gets in.
#
# A browser cannot put a header on a WebSocket handshake, so a consumer asks
# POST /stream-tickets for a one-time ticket over HTTP — where headers work and the
# platform authenticator has already said who is asking — and spends it on the
# handshake, where they do not. This is how long an unspent ticket stays good for;
# spending it is what really ends it (tickets.py).
STREAM_TICKET_TTL_SECONDS=30

# Whether something stands in front of this module and authenticates callers (Easy Auth,
# in Azure). With this on, a request for a ticket that carries no identity is refused —
# the module does not take on trust that the layer in front is doing its job, because one
# wrong line in Terraform would otherwise leave an open ticket factory, which is an open
# stream. Off locally, where nothing stands in front and there is no identity to have.
REQUIRE_AUTHENTICATED_PRINCIPAL=false

# How much this module says. Nothing else sets a level or a destination for the root
# logger — uvicorn configures only its own three — so without this the module writes
# into the void: on the deployed container the access log appeared and not one line
# from `market_data.*`, which is how a collection job that never started looked exactly
# like one running quietly. INFO by default; WARNING to turn it down without a deploy.
LOG_LEVEL=INFO
