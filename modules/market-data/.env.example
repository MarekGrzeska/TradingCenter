# capital-gateway, this module's only upstream. Pointing either of these at capital.com
# is refused at startup — the gateway owns the single rate gate and the demo-only guard.
GATEWAY_BASE_URL=http://localhost:8010
GATEWAY_STREAM_URL=ws://localhost:8010/ws/stream

# capital-gateway is not public: every request and handshake must carry this or be refused before capital.com is
# touched. Required — without it the module runs and archives nothing, and the gap surfaces as silence hours later.
GATEWAY_API_KEY=

# The archive's own storage — the local container in ../../compose.yaml, whose credentials these match exactly.
# DATABASE_USER left unset is what selects local mode, and it narrows the module to loopback: config.py refuses any
# remote host without an identity. The AZURE_* variables below belong to production's shape and stay empty here.
DATABASE_URL=postgresql://market_data:change-me@127.0.0.1:55432/market_data
DATABASE_USER=

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# How much of the provider's 10 req/s allowance this module may take. One deep fill at a
# time, because two of them together starve the chart someone is looking at right now.
BACKFILL_CONCURRENCY=1

# How far back a newly tracked pair reaches on its first fill, in candles.
DEFAULT_BACKFILL_BARS=5000

# The gateway holds one provider connection per tracked pair and the provider limits how many a session may hold.
# A pair is one (symbol, resolution), so one instrument on all eight time frames spends eight of these.
MAX_TRACKED_PAIRS=160

# How long an unspent stream ticket stays good for. A browser cannot put a header on a WebSocket handshake, so a
# consumer asks for a one-time ticket over HTTP, where headers work — and spending it is what really ends it.
STREAM_TICKET_TTL_SECONDS=30

# Whether something in front authenticates callers. With it on, a ticket request carrying no identity is refused: the
# module does not trust that layer, because one wrong line in Terraform leaves an open ticket factory.
REQUIRE_AUTHENTICATED_PRINCIPAL=false

# Who may reach which surface once the layer in front has let them in — Easy Auth authorizes an application, not a
# route, so without these a caller admitted for the read-only tools could also collect and delete a pair. Empty here
# on purpose: they are read only where REQUIRE_AUTHENTICATED_PRINCIPAL is on, which is Azure.
TOOL_CALLER_APPLICATION_IDS=
REST_CALLER_APPLICATION_IDS=

# How much this module says. Nothing else configures the root logger, so without this it writes into the void — on the
# deployed container a collection job that never started looked exactly like one running quietly.
LOG_LEVEL=INFO
