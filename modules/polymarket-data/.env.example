# Polymarket, this module's only upstream and the only place in this repository that
# reaches it. Two hosts because the provider publishes two surfaces: the metadata one,
# which names events, markets and outcomes and carries every outcome's midpoint in a
# single response, and the order-book one, which holds the time series and the per-token
# quotes. Both are public and need no key — this is the first upstream here that a module
# has nothing to present to.
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com

# How this module names itself to the provider. Not politeness: the provider's edge selects
# on this header and refuses some clients' defaults — Python-urllib gets 403 "error code:
# 1010" on both surfaces, where an absent header and httpx's own default are served. A
# library default is a value somebody else decides, and its changing on a dependency bump
# would be an access refusal with no change in this module.
PROVIDER_USER_AGENT=tradingcenter-polymarket-data/0.1 (+https://github.com/MarekGrzeska)

# The archive's own storage — the local container in ../../compose.yaml. The role and
# database are created by scripts/dev.py if they are missing, so a fresh checkout that
# copies this file needs no further edit. Development credentials for a database bound to
# loopback, not a secret.
#
# DATABASE_USER left unset is what selects this local mode — and it narrows the module to
# loopback: without an identity, config.py refuses any remote host, production included.
DATABASE_URL=postgresql://polymarket:change-me@127.0.0.1:55432/polymarket
DATABASE_USER=

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# How much of the provider's allowance this module may take. Measured 22 August 2026:
# ~12 requests/second drew no refusal, and the source application ran at 6 concurrent for
# a year. Raise on evidence, not on hope — the provider documents no limit at all.
PROVIDER_CONCURRENCY=6

# Seconds between samples of every tracked event. One request per event, not per outcome,
# so this multiplied by MAX_TRACKED_EVENTS is the whole steady-state traffic.
SAMPLE_INTERVAL_SECONDS=60

# The provider caps one price-history request at 15 days between startTs and endTs —
# measured, and on the time interval rather than the point count, so a coarser resolution
# does not buy a wider window. A setting because the provider may move it, and a module
# that silently stopped backfilling would be worse than one that refused.
HISTORY_WINDOW_DAYS=15

# How far back a newly tracked event reaches on its first fill. Divided by the window
# above, this is a request count: 90 days is six requests per outcome.
DEFAULT_BACKFILL_DAYS=90

# Tracking is a capability of the model as well as of the operator, so "add whatever looks
# interesting" needs somewhere to stop. Counts events, not markets — one request covers an
# event however many markets it holds, and a single election event was measured at 128.
MAX_TRACKED_EVENTS=50

# Whether something stands in front of this module and authenticates callers (Easy Auth,
# in Azure). Off locally, where nothing stands in front and there is no identity to have.
REQUIRE_AUTHENTICATED_PRINCIPAL=false

# Who may reach which surface, once the layer in front has let them in. This module serves
# two: the REST contract the terminal reads, and the tool surface at /mcp the workbench
# calls. Easy Auth authorizes an application, not a route, so without these two lists a
# caller admitted for the tools could also delete collected history — which is the one
# operation here nobody can undo.
#
# Comma-separated application identifiers, and empty here on purpose: they are read only
# where REQUIRE_AUTHENTICATED_PRINCIPAL is on, which is Azure.
TOOL_CALLER_APPLICATION_IDS=
REST_CALLER_APPLICATION_IDS=

# How much this module says. Nothing else sets a level or a destination for the root
# logger — uvicorn configures only its own three. INFO by default.
LOG_LEVEL=INFO
