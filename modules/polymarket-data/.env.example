# Polymarket, this module's only upstream. Two hosts because the provider publishes two surfaces: metadata with every
# outcome's midpoint, and the order book with the time series. Both public — the first upstream here with no credential.
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com

# How this module names itself to the provider. Not politeness: its edge refuses some clients' defaults — Python-urllib
# gets 403 "error code: 1010" on both surfaces — and a library default is a value somebody else decides.
PROVIDER_USER_AGENT=tradingcenter-polymarket-data/0.1 (+https://github.com/MarekGrzeska)

# The archive's own storage — the local container in ../../compose.yaml, whose role and database `scripts/dev.py`
# creates if missing. DATABASE_USER left unset selects local mode, which config.py narrows to loopback.
DATABASE_URL=postgresql://polymarket:change-me@127.0.0.1:55432/polymarket
DATABASE_USER=

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# How much of the provider's allowance this module may take. Measured 22 August 2026: ~12 requests/second drew no
# refusal. Raise on evidence, not on hope — the provider documents no limit at all.
PROVIDER_CONCURRENCY=6

# Seconds between samples of every tracked event. One request per event, not per outcome,
# so this multiplied by MAX_TRACKED_EVENTS is the whole steady-state traffic.
SAMPLE_INTERVAL_SECONDS=60

# How many connections of the pool's ten collection may hold at once. A tick gathers every tracked event, so
# uncapped the sampler took all ten and a read queued on an acquire that has no deadline.
SAMPLER_DB_CONCURRENCY=3

# The provider caps one price-history request at 15 days between startTs and endTs — measured, and on the interval
# rather than the point count. A setting because the provider may move it, and silent backfill would be worse.
HISTORY_WINDOW_DAYS=15

# How far back a newly tracked event reaches on its first fill. Divided by the window
# above, this is a request count: 90 days is six requests per outcome.
DEFAULT_BACKFILL_DAYS=90

# Tracking is a capability of the model as well as the operator, so "add whatever looks interesting" needs somewhere
# to stop. Counts events, not markets: one request covers an event, and a single election event measured 128.
MAX_TRACKED_EVENTS=50

# Whether something stands in front of this module and authenticates callers (Easy Auth,
# in Azure). Off locally, where nothing stands in front and there is no identity to have.
REQUIRE_AUTHENTICATED_PRINCIPAL=false

# Who may reach which surface once the layer in front has let them in — without these two lists a caller admitted for
# the tools could also delete collected history, the one operation here nobody can undo. Read only in Azure.
TOOL_CALLER_APPLICATION_IDS=
REST_CALLER_APPLICATION_IDS=

# How much this module says. Nothing else sets a level or a destination for the root
# logger — uvicorn configures only its own three. INFO by default.
LOG_LEVEL=INFO
