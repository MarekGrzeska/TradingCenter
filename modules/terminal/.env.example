# Client-side. Each accepts a relative path (proxied by Vite in dev, or by whatever
# reverse proxy fronts the terminal in production) or a full URL (the service reached
# directly). HTTP and WS are kept separate because Azure Static Web Apps cannot proxy a
# WebSocket — see design.md in openspec/changes/add-terminal.
#
# Candles and the live stream come from market-data; the instrument catalogue comes from
# capital-gateway, which owns it. Two services, two addresses.
VITE_GATEWAY_HTTP=/api
VITE_ARCHIVE_HTTP=/archive
VITE_ARCHIVE_WS=/archive/ws

# Server-side, read only by vite.config.ts as the dev proxy's targets. Not shipped to
# the browser. Defaults are each module's standard local port.
GATEWAY_PROXY_TARGET=http://localhost:8010
ARCHIVE_PROXY_TARGET=http://localhost:8020
