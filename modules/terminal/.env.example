# Client-side. Accepts a relative path (proxied by Vite in dev, or by whatever reverse
# proxy fronts the terminal in production) or a full URL (the service reached directly).
# HTTP and WS are kept separate because Azure Static Web Apps cannot proxy a WebSocket —
# see design.md in openspec/changes/add-terminal.
#
# One address for market-data: candles, the live stream, and — proxied through it — the
# instrument catalogue that capital-gateway owns. The catalogue still travels that way.
#
# capital-gateway has an address of its own since the Accounts screen, and only for the
# account: it recognises an authenticated browser and lets it reach the demo accounts,
# their positions and their balances, and refuses it everything else it serves
# (openspec/changes/accounts-screen-opens-the-gateway). In dev this is a prefix the dev
# server proxies, because the shared key must stay out of the browser — set
# GATEWAY_PROXY_KEY below to the same value capital-gateway's own .env holds.
#
# A relative prefix here must not collide with a tab's route: `/archive` is the Archive
# tab, so the archive answers on `/archive-api`. A back end holding a prefix the router
# also claims shadows the tab for reloads and bookmarks, and only for those — which is
# how it hides.
VITE_ARCHIVE_HTTP=/archive-api
VITE_ARCHIVE_WS=/archive-api/ws

# Server-side, read only by vite.config.ts as the dev proxy's target. Not shipped to
# the browser. Default is market-data's standard local port.
ARCHIVE_PROXY_TARGET=http://localhost:8020

# The workbench — the conversation and the team catalogue, one process — reached directly
# rather than through the archive, because nothing proxies it. **One address where there
# were two**: `VITE_AGENT_HTTP` and `VITE_TEAMS_HTTP` are gone, and an `.env` still carrying
# either is one from before that merge.
#
# Same prefix rule as above: `-api` keeps it clear of the `/teams` tab it would otherwise
# shadow on a reload.
VITE_WORKBENCH_HTTP=/workbench-api
WORKBENCH_PROXY_TARGET=http://localhost:8030

# Who the operator is, and what the terminal asks a token *for*.
#
# All three, or none. **None is a working mode, not a gap** — locally the archive
# runs on this machine with nothing in front of it, so the terminal attaches no
# credential and never asks anyone to sign in. Two out of three refuses to start,
# because that is a typo and the alternative is a sign-in that fails much later
# with a message about audiences.
#
# The scope names market-data, not the terminal: the token is presented to the
# archive, and Entra only mints one for a resource asked for by name. Values:
# `terraform output terminal_entra_client_id` / `_tenant_id` / `_scope` in `infra/`.
# All three are public — they travel in every authorization request the browser
# makes. Never secrets.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_SCOPE=

# The account, read from capital-gateway. A prefix in dev (proxied, with the key attached
# server-side) or a full URL in production, where the browser's own token is the credential.
VITE_GATEWAY_HTTP=/gateway-api

# Server-side, dev only, and never in the bundle: the key the dev proxy attaches to every
# request it forwards to capital-gateway. Same value as GATEWAY_API_KEY in that module's
# own .env — the gateway compares them.
GATEWAY_PROXY_TARGET=http://localhost:8010
GATEWAY_PROXY_KEY=
