# Client-side. A relative path (proxied by Vite in dev) or a full URL, HTTP and WS separate because Static Web Apps
# cannot proxy a WebSocket. capital-gateway has its own address since the Accounts screen, and only for the account.
#
# A relative prefix must not collide with a tab's route: `/archive` is the Archive tab, so the archive answers on
# `/archive-api`. A back end holding a tab's prefix shadows it for reloads and bookmarks only, which is how it hides.
VITE_ARCHIVE_HTTP=/archive-api
VITE_ARCHIVE_WS=/archive-api/ws

# Server-side, read only by vite.config.ts as the dev proxy's target. Not shipped to
# the browser. Default is market-data's standard local port.
ARCHIVE_PROXY_TARGET=http://localhost:8020

# The workbench — the conversation and the team catalogue, one process — reached directly, because nothing proxies it.
# **One address where there were two**: an `.env` still carrying `VITE_AGENT_HTTP` or `VITE_TEAMS_HTTP` predates the merge.
VITE_WORKBENCH_HTTP=/workbench-api
WORKBENCH_PROXY_TARGET=http://localhost:8030

# Who the operator is, and what the terminal asks a token *for*. All three, or none: **none is a working mode**, since
# locally nothing stands in front of the archive, while two out of three is a typo that would fail much later.
#
# The scope names market-data, because Entra only mints a token for a resource asked for by name. All three are public
# — they travel in every authorization request the browser makes. `terraform output` gives the values.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_SCOPE=

# **One scope per back end**, because each accepts a token minted for its own audience; until 22 August 2026 the
# terminal asked for the one above and presented it everywhere. An absent one is NOT a fallback to the archive's token
# — that back end is called with no credential and refuses, which is a refusal a tab can name.
VITE_ENTRA_SCOPE_WORKBENCH=
VITE_ENTRA_SCOPE_GATEWAY=
VITE_ENTRA_SCOPE_POLYMARKET=
VITE_ENTRA_SCOPE_STRATEGY=

# The account, read from capital-gateway. A prefix in dev (proxied, with the key attached
# server-side) or a full URL in production, where the browser's own token is the credential.
VITE_GATEWAY_HTTP=/gateway-api

# The prediction-market archive, served by the workbench under /polymarket: a prefix in dev, a full URL in production. Nothing is attached server-side — it wants
# a token in Azure and nothing at all locally, where REQUIRE_AUTHENTICATED_PRINCIPAL is off.
VITE_POLYMARKET_HTTP=/polymarket-api


# The strategy platform: the catalogue, the watches, and every decision with its reason.
# A prefix in dev (proxied to 8080) or a full URL in production.
VITE_STRATEGY_HTTP=/strategy-api

# Server-side, dev only: where the /strategy-api prefix is forwarded. Defaults to 8080.
STRATEGY_PROXY_TARGET=

# Server-side, dev only, never in the bundle: the key the dev proxy attaches to what it forwards to capital-gateway.
# The same value as GATEWAY_API_KEY in that module's own .env, which is what the gateway compares it against.
GATEWAY_PROXY_TARGET=http://localhost:8010
GATEWAY_PROXY_KEY=
