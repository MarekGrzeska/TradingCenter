# Client-side. Each accepts a relative path (proxied by Vite in dev, or by whatever
# reverse proxy fronts the terminal in production) or a full URL (the gateway reached
# directly). Kept separate because Azure Static Web Apps cannot proxy a WebSocket —
# see design.md in openspec/changes/add-terminal.
VITE_GATEWAY_HTTP=/api
VITE_GATEWAY_WS=/ws

# Server-side, read only by vite.config.ts as the dev proxy's target. Not shipped to
# the browser. Defaults to capital-gateway's standard local port.
GATEWAY_PROXY_TARGET=http://localhost:8010
