{
  "turns": [
    {
      "when": "^E2E nowa: (?<name>.+)$",
      "rounds": [
        {
          "tools": [
            {
              "name": "draft_strategy",
              "arguments": {
                "document": {
                  "schema": 1,
                  "name": "{name}",
                  "hypothesis": "Wejście o 9:00 UTC ma przewagę na US100.",
                  "symbol": "US100",
                  "timeframe": "HOUR",
                  "params": { "stop": { "default": 50, "min": 20, "max": 100, "step": 10 } },
                  "entries": [{ "side": "long", "when": "hour == 9" }],
                  "exits": { "stop": "entry_price - p.stop", "target": "entry_price + p.stop" },
                  "sizing": { "mode": "fixed_units", "value": 1 }
                }
              }
            }
          ]
        },
        { "say": "Wpisałem szkic nowej strategii do edytora." }
      ]
    },
    {
      "when": "^E2E szkic (?<id>\\d+)$",
      "rounds": [
        {
          "tools": [
            {
              "name": "draft_strategy",
              "arguments": {
                "strategy_id": "{id}",
                "document": {
                  "schema": 1,
                  "name": "E2E szkic {id}",
                  "symbol": "US100",
                  "timeframe": "HOUR",
                  "params": { "stop": { "default": 70, "min": 20, "max": 100, "step": 10 } },
                  "entries": [{ "side": "long", "when": "hour == 9" }],
                  "exits": { "stop": "entry_price - p.stop", "target": "entry_price + p.stop" },
                  "sizing": { "mode": "fixed_units", "value": 1 }
                }
              }
            }
          ]
        },
        { "say": "Wpisałem szersze stopy do edytora." }
      ]
    },
    {
      "when": "^E2E zapisz (?<id>\\d+) na (?<base>\\d+)$",
      "rounds": [
        {
          "tools": [
            {
              "name": "save_strategy",
              "arguments": {
                "strategy_id": "{id}",
                "based_on": "{base}",
                "document": {
                  "schema": 1,
                  "name": "E2E zapis {id}",
                  "symbol": "US100",
                  "timeframe": "HOUR",
                  "params": { "stop": { "default": 80, "min": 20, "max": 100, "step": 10 } },
                  "entries": [{ "side": "long", "when": "hour == 9" }],
                  "exits": { "stop": "entry_price - p.stop", "target": "entry_price + p.stop" },
                  "sizing": { "mode": "fixed_units", "value": 1 }
                }
              }
            }
          ]
        },
        { "say": "Zapisałem nową rewizję." }
      ]
    },
    {
      "when": "^E2E backtest (?<id>\\d+) (?<from>\\S+) (?<to>\\S+)$",
      "rounds": [
        {
          "tools": [
            { "name": "run_backtest", "arguments": { "strategy_id": "{id}", "start": "{from}", "end": "{to}" } }
          ]
        },
        { "say": "Backtest policzony." }
      ]
    },
    { "when": "^E2E ping$", "rounds": [{ "say": "pong" }] }
  ]
}
