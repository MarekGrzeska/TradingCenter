# The workbench of the end-to-end stack, passed as its environment from a directory with no .env, so the developer's
# modules/workbench/.env — real keys included — is never read. Everything that costs money or reaches outside points at
# 127.0.0.1:9, where nothing listens: a misconfiguration fails on this machine instead of billing a provider.
AGENT_DATABASE_URL=postgresql://agent:change-me@127.0.0.1:55442/agent
TEAMS_DATABASE_URL=postgresql://teams:change-me@127.0.0.1:55442/teams
MARKET_DATABASE_URL=postgresql://market_data:change-me@127.0.0.1:55442/market_data
POLYMARKET_DATABASE_URL=postgresql://polymarket:change-me@127.0.0.1:55442/polymarket
SOCIAL_DATABASE_URL=postgresql://social:change-me@127.0.0.1:55442/social
TELEGRAM_DATABASE_URL=postgresql://telegram:change-me@127.0.0.1:55442/telegram
STRATEGIES_DATABASE_URL=postgresql://strategies:change-me@127.0.0.1:55442/strategies
YOUTUBE_DATABASE_URL=
ALERTS_DATABASE_URL=
DATABASE_USER=
DATABASE_POOL_SIZE=2

AGENT_OPENAI_API_KEY=sk-e2e-does-not-pay
TEAMS_OPENAI_API_KEY=sk-e2e-does-not-pay
SOCIAL_OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:9/v1
OPENAI_API_BASE=http://127.0.0.1:9/v1
AGENT_MODELS=[{"id":"e2e-luna","model":"e2e-luna","display_name":"E2E Luna","cost_rank":1,"input_rate_per_1m":"0.001","output_rate_per_1m":"0.001"},{"id":"e2e-sol","model":"e2e-sol","display_name":"E2E Sol","cost_rank":2,"input_rate_per_1m":"0.001","output_rate_per_1m":"0.001"}]
AGENT_DEFAULT_MODEL_ID=e2e-luna
TEAMS_MODELS=[{"id":"e2e-luna","model":"e2e-luna","display_name":"E2E Luna","cost_rank":1,"input_rate_per_1m":"0.001","output_rate_per_1m":"0.001"}]

GATEWAY_BASE_URL=http://127.0.0.1:9
GATEWAY_STREAM_URL=ws://127.0.0.1:9/ws/stream
GATEWAY_API_KEY=e2e-no-gateway
TRADING_MCP_URL=

POLYMARKET_GAMMA_BASE_URL=http://127.0.0.1:9
POLYMARKET_CLOB_BASE_URL=http://127.0.0.1:9
SOCIAL_TRUTH_SOCIAL_FEED_URL=http://127.0.0.1:9/feed
TELEGRAM_BOT_API_BASE_URL=http://127.0.0.1:9
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_KEY=

SCHEDULER_ENABLED=false
REQUIRE_AUTHENTICATED_PRINCIPAL=false
SERVER_MODE=false
LOG_LEVEL=INFO
