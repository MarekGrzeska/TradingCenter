# Read by the container only; locally there is nothing to run but the tests (`uv run pytest`).
# The public host the tool surfaces answer on, and the Entra values the token helper asks for.
API_HOST=
ENTRA_TENANT_ID=
AGENT_ENTRA_CLIENT_ID=
# The operator's Telegram chat id, from the pairing; check-ins go there.
AGENT_TELEGRAM_OWNER_CHAT_ID=
# "on" moves the six account-writing tools from deny to allow. Anything else, or nothing, keeps them denied.
AGENT_ACCOUNT_WRITES=
# "HH:MM skill" pairs, comma-separated; "none" turns check-ins off. Empty is the default below.
AGENT_CHECKINS=08:30 przeglad-rana,21:30 podsumowanie-dnia
