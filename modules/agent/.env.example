# The archive's own storage — the local container in ../../compose.yaml, second
# database (dev.sh/dev.ps1 create `agent` alongside `market_data` on first run).
#
# DATABASE_USER left unset is what selects local mode — without an identity, config.py
# refuses any remote host, production included. The remote shape (identity, TLS, no
# password in the URL) is production's, set by infra/app-service.tf.
DATABASE_URL=postgresql://agent:change-me@127.0.0.1:55432/agent
DATABASE_USER=

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Azure OpenAI, this module's only model provider. The endpoint of the
# azurerm_cognitive_account created by infra/openai.tf.
AZURE_OPENAI_ENDPOINT=https://<account-name>.openai.azure.com
# No default on purpose — check the current value in Azure OpenAI's REST reference
# before setting this; a guessed date answers 400 for a reason nothing here explains.
AZURE_OPENAI_API_VERSION=

# Exactly one of these two selects how this module authenticates to Azure OpenAI.
# Locally: a key, copied from the Azure OpenAI resource. In Azure: the flag below, and
# the app's managed identity carries the Cognitive Services OpenAI User role instead —
# see infra/app-service.tf and infra/openai.tf.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_USE_MANAGED_IDENTITY=false

# The models this module offers, as a JSON array — one entry per Azure OpenAI
# deployment. `id` is this module's own stable identifier (carried in every session and
# usage row); `deployment` is the name in Azure OpenAI, which may differ or move.
# Rates are per 1000 tokens. Confirm current rates before deploying — they move faster
# than this module does (design.md, "Cennik jest konfiguracją"). The three below are
# illustrative, read from public pricing in August 2026 — Azure's own invoiced rate has
# been observed to lag that announcement, so check the Azure OpenAI resource's own
# pricing page rather than trusting this file.
MODELS=[{"id":"gpt-5.6-luna","deployment":"gpt-5.6-luna","display_name":"Luna","cost_rank":1,"input_rate_per_1k":"0.0002","output_rate_per_1k":"0.0012"},{"id":"gpt-5.6-terra","deployment":"gpt-5.6-terra","display_name":"Terra","cost_rank":2,"input_rate_per_1k":"0.002","output_rate_per_1k":"0.012"},{"id":"gpt-5.6-sol","deployment":"gpt-5.6-sol","display_name":"Sol","cost_rank":3,"input_rate_per_1k":"0.005","output_rate_per_1k":"0.03"}]

# The session a new conversation gets when the operator does not choose one. MUST be
# one of the ids configured above.
DEFAULT_MODEL_ID=gpt-5.6-luna

# Whether something stands in front of this module and authenticates callers (Easy
# Auth, in Azure). Off locally, where nothing stands in front and there is no identity
# to have.
REQUIRE_AUTHENTICATED_PRINCIPAL=false

# How much this module says. INFO by default; WARNING to turn it down without a deploy.
LOG_LEVEL=INFO
