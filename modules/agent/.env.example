# The archive's own storage — the local container in ../../compose.yaml, second
# database (dev.sh/dev.ps1 create `agent` alongside `market_data` on first run).
#
# DATABASE_USER left unset is what selects local mode — without an identity, config.py
# refuses any remote host, production included. The remote shape (identity, TLS, no
# password in the URL) is production's, set by infra/app-service.tf.
DATABASE_URL=postgresql://agent:change-me@127.0.0.1:55432/agent
DATABASE_USER=

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# OpenAI, this module's only model provider. The key is the only credential it accepts —
# there is no managed-identity mode here the way there is for the database, because
# OpenAI is not in Entra and has nobody to present an Entra token to. In Azure this same
# value arrives as a Key Vault reference (infra/key-vault.tf, secret `openai-api-key`).
OPENAI_API_KEY=

# The models this module offers, as a JSON array. `id` is this module's own stable
# identifier (carried in every session and usage row); `model` is what OpenAI is asked
# for, kept separate because an id outlives a model renamed or retired upstream.
# Rates are per 1,000,000 tokens — the unit OpenAI's own pricing page quotes, so a rate
# is copied across without arithmetic in either direction. Confirm current rates before
# deploying: they move faster than this module does (design.md, "Cennik jest
# konfiguracją"). The three below are illustrative, read from public pricing in August
# 2026; confirm each `model` against `GET https://api.openai.com/v1/models` too — a name
# from memory fails at the first turn.
MODELS=[{"id":"gpt-5.6-luna","model":"gpt-5.6-luna","display_name":"Luna","cost_rank":1,"input_rate_per_1m":"0.2","output_rate_per_1m":"1.2"},{"id":"gpt-5.6-terra","model":"gpt-5.6-terra","display_name":"Terra","cost_rank":2,"input_rate_per_1m":"2","output_rate_per_1m":"12"},{"id":"gpt-5.6-sol","model":"gpt-5.6-sol","display_name":"Sol","cost_rank":3,"input_rate_per_1m":"5","output_rate_per_1m":"30"}]

# The session a new conversation gets when the operator does not choose one. MUST be
# one of the ids configured above.
DEFAULT_MODEL_ID=gpt-5.6-luna

# market-mcp, this module's only tool server. Left unset the agent has no tools and
# answers from the model alone — which is what it did before this setting existed, and
# what it falls back to when the server is down. MARKET_MCP_SCOPE is set only when the
# URL points off this machine (api://<market-mcp-app-id>/.default); a scope against
# loopback is refused at startup, and so is a remote URL without one.
MARKET_MCP_URL=http://127.0.0.1:8040
MARKET_MCP_SCOPE=
MARKET_MCP_REQUEST_TIMEOUT_SECONDS=15

# teams-mcp, the tool server the agent builds and runs teams through. Left unset the
# agent works exactly as before and simply has no teams tools — the same supported
# state MARKET_MCP_URL's absence is, and the two are configured independently.
# Unlike market-mcp, calls here carry the operator's own credential, taken off the
# request being served: a team created from the chat belongs to the person who asked
# for it, not to this module. Longer timeout because a call can create a team or start
# a run, and teams-mcp itself waits up to 30s on teams.
TEAMS_MCP_URL=http://127.0.0.1:8070
TEAMS_MCP_SCOPE=
TEAMS_MCP_REQUEST_TIMEOUT_SECONDS=35

# Whether something stands in front of this module and authenticates callers (Easy
# Auth, in Azure). Off locally, where nothing stands in front and there is no identity
# to have.
REQUIRE_AUTHENTICATED_PRINCIPAL=false

# How much this module says. INFO by default; WARNING to turn it down without a deploy.
LOG_LEVEL=INFO
