# Where teams is listening. TEAMS_SCOPE is set only when this URL points off this
# machine (api://<teams-app-id>/.default); a scope against loopback is refused at
# startup, and so is a remote URL without one.
TEAMS_URL=http://127.0.0.1:8050
TEAMS_SCOPE=
# Just past teams' own run-start work. A tool call here is one HTTP call there, and
# the slowest of them creates a run.
TEAMS_REQUEST_TIMEOUT_SECONDS=30

TEAMS_MCP_PORT=8070
# Loopback locally. The container sets 0.0.0.0 (Dockerfile) because the platform
# reaches it from outside; a desk has no reason to publish these tools to its network.
TEAMS_MCP_HOST=127.0.0.1

# Whether a platform authenticator (Easy Auth) stands in front of this module.
# False locally, where nothing stands in front; true in Azure (infra/app-service.tf).
REQUIRE_AUTHENTICATED_PRINCIPAL=false
