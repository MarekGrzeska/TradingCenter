# One process, two surfaces — and therefore one .env where there used to be three. A name with a prefix is one of the
# four things doubled on purpose; everything else is one setting, read only by `workbench/config.py`.

# --- storage: two databases, one identity ---------------------------------------------
#
# Two logical databases in the local container from ../../compose.yaml, which scripts/dev.py creates on first run.
# DATABASE_USER left unset selects local mode, and one value serves both, because one App Service has one identity.
AGENT_DATABASE_URL=postgresql://agent:change-me@127.0.0.1:55432/agent
TEAMS_DATABASE_URL=postgresql://teams:change-me@127.0.0.1:55432/teams
DATABASE_USER=

# How many connections this module may hold at once. Seven logical databases share one
# B_Standard_B1ms whose max_connections is 35, so the numbers across the modules are one budget:
# scripts/tests/test_pool_budget.py adds them up and refuses a total above 30. Both pools of
# this process take this value, so its share of the server is twice it.
DATABASE_POOL_SIZE=4

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# --- OpenAI: two keys, deliberately ----------------------------------------------------
#
# The only credential either surface accepts — OpenAI is not in Entra, so there is no managed-identity mode here.
# Two of them so the team experiments' cost shows up on its own line; in Azure, two Key Vault references.
AGENT_OPENAI_API_KEY=
TEAMS_OPENAI_API_KEY=

# --- the two catalogues ----------------------------------------------------------------
#
# `id` is this repository's own stable identifier and `model` is what OpenAI is asked for, kept apart because an id
# outlives a model renamed upstream. Rates are per 1,000,000 tokens, the unit OpenAI's own pricing page quotes.
# Confirm both the rates and each `model` before deploying — they move faster than this module does.
AGENT_MODELS=[{"id":"gpt-6-luna","model":"gpt-6-luna","display_name":"GPT-6 Luna","cost_rank":1,"input_rate_per_1m":"0.1","output_rate_per_1m":"0.5"},{"id":"gpt-6.1-sol","model":"gpt-6.1-sol","display_name":"GPT-6.1 Sol","cost_rank":2,"input_rate_per_1m":"2","output_rate_per_1m":"10"},{"id":"gpt-6-astra","model":"gpt-6-astra","display_name":"GPT-6 Astra","cost_rank":3,"input_rate_per_1m":"10","output_rate_per_1m":"50"}]

# The model a new conversation gets when the operator chooses none; MUST be one of the ids in AGENT_MODELS. There is
# no TEAMS_DEFAULT_MODEL_ID: every agent in a saved revision names its own model, so there is nothing to fall back for.
AGENT_DEFAULT_MODEL_ID=gpt-6-luna
# `sim` makes the conversation answer from AGENT_SIM_SCENARIO, a scenario file, instead of OpenAI: the end-to-end stack's
# model (modules/terminal/e2e), no network and no cost. Refused wherever DATABASE_USER is set, so it cannot reach a
# deployment.
AGENT_PROVIDER=openai
AGENT_SIM_SCENARIO=

TEAMS_MODELS=[{"id":"gpt-6-luna","model":"gpt-6-luna","display_name":"GPT-6 Luna","cost_rank":1,"input_rate_per_1m":"0.1","output_rate_per_1m":"0.5"},{"id":"gpt-6.1-sol","model":"gpt-6.1-sol","display_name":"GPT-6.1 Sol","cost_rank":2,"input_rate_per_1m":"2","output_rate_per_1m":"10"},{"id":"gpt-6-astra","model":"gpt-6-astra","display_name":"GPT-6 Astra","cost_rank":3,"input_rate_per_1m":"10","output_rate_per_1m":"50"}]

# --- market-data, the candle archive — the fourth package of this process, under /market ---
#
# Its database is the local container's own (compose.yaml creates the `market_data` role and database), read under
# the same DATABASE_USER as everything above; what is the archive's alone under MARKET_. Its eleven read-only tools
# are a layer in this process now, so there is no MARKET_MCP_URL any more — a .env still carrying one predates
# `one-process-per-security-boundary`. The largest pool: the only writer of a row per closed candle per pair.
MARKET_DATABASE_URL=postgresql://market_data:change-me@127.0.0.1:55432/market_data
MARKET_DATABASE_POOL_SIZE=8
MARKET_BACKFILL_CONCURRENCY=1
MARKET_DEFAULT_BACKFILL_BARS=5000
MARKET_MAX_TRACKED_PAIRS=160
MARKET_STREAM_TICKET_TTL_SECONDS=30

# capital-gateway, the archive's only upstream and this process's one door to the provider. Pointing either address
# at capital.com is refused at startup — the gateway owns the single rate gate and the demo-only guard. The key must
# be the gateway's own GATEWAY_API_KEY: every request and handshake carries it, or the archive collects nothing.
GATEWAY_BASE_URL=http://localhost:8010
GATEWAY_STREAM_URL=ws://localhost:8010/ws/stream
GATEWAY_API_KEY=
GATEWAY_SCOPE=

# --- trading-mcp, the tool server that moves the account --------------------------------
#
# Positions, balance and orders. Left unset, neither surface can see a position or send anything. No operator
# credential travels here — what guards it is that the account is a demo one, checked before the port opens.
TRADING_MCP_URL=http://127.0.0.1:8060
TRADING_MCP_SCOPE=
# On a server: trading-mcp is reached by name on the internal network (add it to PRIVATE_HOSTS) with the gateway's own
# key, because there is no managed identity to present a scope with. Set one or the other, never both.
TRADING_MCP_API_KEY=
PRIVATE_HOSTS=
TRADING_MCP_REQUEST_TIMEOUT_SECONDS=35

# --- polymarket-data, the prediction-market archive — a package of this process ------------
#
# Its own database in the same local container (scripts/dev.py creates the `polymarket` role and database), read
# under the same DATABASE_USER as the two above. What is the archive's alone is read under POLYMARKET_; the
# defaults are the ones its config.py carries, so only the URL is required here.
POLYMARKET_DATABASE_URL=postgresql://polymarket:change-me@127.0.0.1:55432/polymarket
POLYMARKET_DATABASE_POOL_SIZE=3
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_PROVIDER_USER_AGENT=tradingcenter-polymarket-data/0.1 (+https://github.com/MarekGrzeska)
POLYMARKET_SAMPLE_INTERVAL_SECONDS=60
POLYMARKET_DEFAULT_BACKFILL_DAYS=30
POLYMARKET_MAX_TRACKED_EVENTS=50
# Who may reach `/polymarket/mcp` from outside (nobody in production: the conversation calls those tools in this
# process) and which browsers reach `/polymarket` over REST. Both empty locally, like REQUIRE_AUTHENTICATED_PRINCIPAL.
TOOL_CALLER_APPLICATION_IDS=
REST_CALLER_APPLICATION_IDS=
# There is no POLYMARKET_MCP_URL any more: the archive's tools are a layer in this process, like the team tools.

# --- social-data, the post archive — the second package of this process ------------------
#
# The same arrangement as the archive above: its own database in the same container (`social` role and database,
# created by scripts/dev.py), the same DATABASE_USER, and what is the archive's alone under SOCIAL_. The model key
# is the one line worth a second look: **empty is a supported state** — posts are collected and every reading
# stays empty, which /social/state says. In production it is the conversation's key, so the readings bill on the
# same line as the chat.
SOCIAL_DATABASE_URL=postgresql://social:change-me@127.0.0.1:55432/social
SOCIAL_DATABASE_POOL_SIZE=3
SOCIAL_TRUTH_SOCIAL_FEED_URL=https://www.trumpstruth.org/feed
SOCIAL_PROVIDER_USER_AGENT=tradingcenter-social-data/0.1 (+https://github.com/MarekGrzeska)
SOCIAL_COLLECT_INTERVAL_SECONDS=300
SOCIAL_COLLECT_WINDOW_HOURS=24
SOCIAL_NEWS_TICK_SECONDS=30
SOCIAL_NEWS_RETENTION_DAYS=28
SOCIAL_OPENAI_API_KEY=
SOCIAL_TRANSLATION_MODEL=gpt-6-luna
SOCIAL_ANALYSIS_MODEL=gpt-6.1-sol
SOCIAL_ALERT_MIN_IMPACT_SCORE=8
# Who the archives tell is decided by the rules in the terminal's Alerts tab, not by a setting: the archives hand what
# they read to the alerts package (ALERTS_DATABASE_URL below). There is no ALERT_DESTINATION, no *_ALERT_MIN_IMPACT_SCORE
# and no TELEGRAM_GATEWAY_URL or _SCOPE any more: the door is a package of this process, reached without an address.
# There is no SOCIAL_MCP_URL any more, for the reason there is no POLYMARKET_MCP_URL.


# --- youtube-data, the YouTube archive — optional, the one package a process may run without -------------
#
# **Unset is a working configuration**: the workbench starts without it — no /youtube routes, no tools, no database —
# which is what production does until its own change enables the package. Set, it is all-or-nothing like the others:
# an unreachable database refuses the whole start. Locally it is the `youtube` database in the same container
# (created by scripts/dev.py), and everything the package reads is under YOUTUBE_.
YOUTUBE_DATABASE_URL=
# YOUTUBE_DATABASE_URL=postgresql://youtube:change-me@127.0.0.1:55432/youtube
# YOUTUBE_DATABASE_POOL_SIZE=2
# Its own REST caller list, not the process's: this package writes the watch list and spends provider units on request,
# so a browser that only reads the other archives (the pocket) is not on it. Empty locally, where nothing stands in front.
# YOUTUBE_REST_CALLER_APPLICATION_IDS=
# Where films are found: `data_api`, on a free YouTube Data API key (10,000 units a day; a listing costs 1, a search
# 100). Asked for and keyless is a refused start — the key travels in a header, never in a URL.
# The providers below default to `sim` — a scenario file, no network, no cost, the failures the real ones have
# (a crowded model, a paid miss, a spent day). It is refused wherever DATABASE_USER is set, so it cannot reach a
# deployment. YOUTUBE_SIM_SPEED=24 runs a day of it in an hour; YOUTUBE_SIM_SCENARIO points at another file.
# YOUTUBE_VIDEO_SOURCE=sim
# YOUTUBE_SIM_SPEED=1
# YOUTUBE_SIM_SCENARIO=
# YOUTUBE_DATA_API_KEY=
# Who writes the words down: `gemini` listens to the film from its address, so it needs VIDEO_SOURCE=data_api. YouTube's
# own captions are not read — from Azure YouTube refuses every request for them.
# YOUTUBE_TRANSCRIBER=sim
# Gemini is paid in tokens and limited by Google in hours of film (eight a day on the free tier — whose terms let Google
# use the content, so not for production). The ceiling is seconds of film; a film longer than a piece is cut.
# YOUTUBE_GEMINI_API_KEY=
# YOUTUBE_GEMINI_MODEL=gemini-3.1-flash-lite   # the cheapest that answered; the preview ones were "high demand" on 13 Oct
# YOUTUBE_GEMINI_CHUNK_MINUTES=15
# YOUTUBE_GEMINI_DAILY_VIDEO_SECONDS=28800
# YOUTUBE_GEMINI_TIMEOUT_SECONDS=300
# After a refusal Gemini is not asked again for this long: a crowded model is gone in minutes.
# YOUTUBE_TRANSCRIBER_COOLDOWN_MINUTES=15
# The model. Empty key is a supported state: films are discovered and transcribed, and every reading stays empty.
# YOUTUBE_ANALYSER=sim
# YOUTUBE_OPENAI_API_KEY=
# YOUTUBE_ANALYSIS_MODEL=gpt-6-luna   # the cheap one; gpt-6.1-sol if the readings turn out thin
# The loop: one pass per interval, and how much of each step a pass may do — the rest waits for the next pass. A film with
# no words written down is asked about again after 1 h, 6 h and a day, and then given up on.
# YOUTUBE_POLL_INTERVAL_SECONDS=1800   # what stands until the operator saves another in the terminal (YouTube → Ustawienia)
# YOUTUBE_TRANSCRIBE_BATCH_LIMIT=10
# YOUTUBE_ANALYSE_BATCH_LIMIT=5
# YOUTUBE_RETRY_DELAYS_MINUTES=60,360,1440
# YOUTUBE_MIN_VIDEO_SECONDS=180   # a Short is a slogan: up to three minutes is not worth a transcript
# YOUTUBE_MAX_VIDEO_SECONDS=10800
# The watch list's ceilings, and each provider's day in its own unit — counted here, not trusted to a dashboard.
# YOUTUBE_MAX_CHANNELS=100
# YOUTUBE_MAX_TOPICS=20
# YOUTUBE_DAILY_SOURCE_UNITS=8000
# YOUTUBE_DAILY_TOKEN_LIMIT=2000000
# Who is told is the operator's assignment of `youtube.film`, in the terminal's Telegram tab. What a film must
# score for a `threshold` channel to announce it, and how long an unannounced film may wait before it is let go as quiet.
# YOUTUBE_ALERT_MIN_IMPACT_SCORE=8
# YOUTUBE_ALERT_WINDOW_HOURS=48


# --- alerts, who is told what and when — optional, like the YouTube archive ------------------------------
#
# **Unset is a working configuration**: the workbench starts without it — no /alerts routes, no tools, no database — and
# the archives that would publish events to it simply do not. Set, it is all-or-nothing: an unreachable database refuses
# the whole start. Locally it is the `alerts` database in the same container (created by scripts/dev.py).
ALERTS_DATABASE_URL=
# ALERTS_DATABASE_URL=postgresql://alerts:change-me@127.0.0.1:55432/alerts
# ALERTS_DATABASE_POOL_SIZE=2
# Its own REST caller list: the rules decide who is told what, so a browser that only reads the archives (the pocket) is
# not on it. Empty locally, where nothing stands in front.
# ALERTS_REST_CALLER_APPLICATION_IDS=
# How often the clock wakes, and the shortest a rule may wait between two looks at a value.
# ALERTS_TICK_SECONDS=5
# ALERTS_MIN_INTERVAL_SECONDS=30
# A delivery that could not be made is tried again for this long, then let go; and no rule delivers more than this many
# messages an hour. Events are kept this many days (the fires they caused stay).
# ALERTS_RETRY_WINDOW_HOURS=6
# ALERTS_MAX_PER_HOUR=20
# ALERTS_EVENT_RETENTION_DAYS=30
# The sentence-to-rule draft: its own key and its own ceiling. Absent key is a supported state — everything but drafting works.
# ALERTS_OPENAI_API_KEY=
# ALERTS_DRAFT_MODEL=gpt-6-luna
# ALERTS_DRAFT_DAILY_TOKEN_LIMIT=200000


# --- strategies, the strategy engine — optional, like the alerts -----------------------------------------------
#
# **Unset is a working configuration**: the workbench starts without it — no /strategies routes, no database. Research
# only: nothing in it reaches an account. Set, it is all-or-nothing: an unreachable database refuses the whole start.
# Locally it is the `strategies` database in the same container (created by scripts/dev.py). Not STRATEGY_*: those
# belonged to the platform removed in October, and dev.py still names them as read by nothing.
STRATEGIES_DATABASE_URL=
# STRATEGIES_DATABASE_URL=postgresql://strategies:change-me@127.0.0.1:55432/strategies
# STRATEGIES_DATABASE_POOL_SIZE=2
# Its own REST caller list: the operator's screen. Empty locally, where nothing stands in front.
# STRATEGIES_REST_CALLER_APPLICATION_IDS=
# How many runs compute at once (each in a worker process), the most candles of its execution series one run may read,
# and how long it may compute before it is stopped.
# STRATEGIES_RUN_CONCURRENCY=1
# STRATEGIES_MAX_EXECUTION_BARS=1500000
# STRATEGIES_RUN_TIMEOUT_SECONDS=600
# How many draws the random-entry benchmark takes.
# STRATEGIES_RANDOM_ENTRY_REPETITIONS=100


# There is no TEAMS_MCP_URL any more, and a .env that still carries one is a .env from
# before this change: the team tools are a layer in this process, reached without a port.

# --- telegram_gateway, the one door to Telegram — the fifth package of this process ------
#
# Served under /telegram since stage 4 of `one-process-per-security-boundary`; port 8100 is nobody's now. Its database
# holds bots, their tokens and who receives — never a message. There is no TELEGRAM_MCP_URL: its two tools reach the
# conversation and the teams as functions. What is its own is under TELEGRAM_, the REST caller list included: bots and
# destinations answer the operator's `az` alone, not the browsers the other packages share REST_CALLER_APPLICATION_IDS
# with. Empty locally, where nothing stands in front.
TELEGRAM_DATABASE_URL=postgresql://telegram:change-me@127.0.0.1:55432/telegram
TELEGRAM_DATABASE_POOL_SIZE=4
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
TELEGRAM_MAX_BOTS=20
TELEGRAM_MAX_MESSAGE_CHARS=4096
TELEGRAM_REST_CALLER_APPLICATION_IDS=
# **All empty is a working configuration, not a missing step.** Creating a bot means talking to Telegram's creator bot,
# and only a user account may — use a DEDICATED account for it, never your personal one. The account is logged in from
# the terminal's Telegram tab and its session is kept in the database, encrypted with TELEGRAM_SESSION_KEY; without the
# three the door sends normally and refuses to log in or create bots. TELEGRAM_API_ID and TELEGRAM_API_HASH come from
# my.telegram.org (from that account); give both or neither. The key is made with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_KEY=

# --- how long a run may take ------------------------------------------------------------
#
# The whole run, not one agent. The per-agent ceiling on model-tool rounds is not configurable and lives in the code,
# because a safety ceiling in a settings file is an invitation to raise it at the moment it is inconvenient.
RUN_TIMEOUT_SECONDS=900

# --- the teams surface's own clock -------------------------------------------------------
#
# A schedule firing from a task in this process's lifespan, not from anything in Azure. `false` turns it off without a
# redeploy, leaving every schedule where it is; the threshold is how many failed runs one tolerates before disabling itself.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_SECONDS=15
SCHEDULER_FAILURE_THRESHOLD=3

# Whether something stands in front of this process and authenticates callers (Easy Auth,
# in Azure). Off locally, where nothing stands in front and there is no identity to have.
REQUIRE_AUTHENTICATED_PRINCIPAL=false

# A server with no platform authenticator (move-from-azure-to-vps): this process verifies the Entra token of what came
# through the edge proxy itself. Needs REQUIRE_AUTHENTICATED_PRINCIPAL=true above; audiences are comma-separated.
SERVER_MODE=false
ENTRA_TENANT_ID=
ENTRA_AUDIENCES=

# How much this process says. INFO by default; WARNING to turn it down without a deploy.
LOG_LEVEL=INFO
