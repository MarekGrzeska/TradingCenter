# One process, two surfaces — and therefore one .env where there used to be three. A name with a prefix is one of the
# four things doubled on purpose; everything else is one setting, read only by `workbench/config.py`.

# --- storage: two databases, one identity ---------------------------------------------
#
# Two logical databases in the local container from ../../compose.yaml, which scripts/dev.py creates on first run.
# DATABASE_USER left unset selects local mode, and one value serves both, because one App Service has one identity.
AGENT_DATABASE_URL=postgresql://agent:change-me@127.0.0.1:55432/agent
TEAMS_DATABASE_URL=postgresql://teams:change-me@127.0.0.1:55432/teams
DATABASE_USER=

# How many connections this module may hold at once. Seven logical databases share one
# B_Standard_B1ms whose max_connections is 35, so the numbers across the modules are one budget:
# scripts/tests/test_pool_budget.py adds them up and refuses a total above 30. Both pools of
# this process take this value, so its share of the server is twice it.
DATABASE_POOL_SIZE=4

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# --- OpenAI: two keys, deliberately ----------------------------------------------------
#
# The only credential either surface accepts — OpenAI is not in Entra, so there is no managed-identity mode here.
# Two of them so the team experiments' cost shows up on its own line; in Azure, two Key Vault references.
AGENT_OPENAI_API_KEY=
TEAMS_OPENAI_API_KEY=

# --- the two catalogues ----------------------------------------------------------------
#
# `id` is this repository's own stable identifier and `model` is what OpenAI is asked for, kept apart because an id
# outlives a model renamed upstream. Rates are per 1,000,000 tokens, the unit OpenAI's own pricing page quotes.
# Confirm both the rates and each `model` before deploying — they move faster than this module does.
AGENT_MODELS=[{"id":"gpt-5.6-luna","model":"gpt-5.6-luna","display_name":"Luna","cost_rank":1,"input_rate_per_1m":"0.2","output_rate_per_1m":"1.2"},{"id":"gpt-5.6-terra","model":"gpt-5.6-terra","display_name":"Terra","cost_rank":2,"input_rate_per_1m":"2","output_rate_per_1m":"12"},{"id":"gpt-5.6-sol","model":"gpt-5.6-sol","display_name":"Sol","cost_rank":3,"input_rate_per_1m":"5","output_rate_per_1m":"30"}]

# The model a new conversation gets when the operator chooses none; MUST be one of the ids in AGENT_MODELS. There is
# no TEAMS_DEFAULT_MODEL_ID: every agent in a saved revision names its own model, so there is nothing to fall back for.
AGENT_DEFAULT_MODEL_ID=gpt-5.6-luna

TEAMS_MODELS=[{"id":"gpt-5.6-luna","model":"gpt-5.6-luna","display_name":"Luna","cost_rank":1,"input_rate_per_1m":"0.2","output_rate_per_1m":"1.2"},{"id":"gpt-5.6-terra","model":"gpt-5.6-terra","display_name":"Terra","cost_rank":2,"input_rate_per_1m":"2","output_rate_per_1m":"12"},{"id":"gpt-5.6-sol","model":"gpt-5.6-sol","display_name":"Sol","cost_rank":3,"input_rate_per_1m":"5","output_rate_per_1m":"30"}]

# --- market-data's tool surface, read by both -------------------------------------------
#
# The archive's read-only tools are a route of market-data itself, which is why this points at 8020. Left unset,
# neither surface has archive tools — a supported state. MARKET_MCP_SCOPE is set exactly when the URL is remote.
MARKET_MCP_URL=http://127.0.0.1:8020
MARKET_MCP_SCOPE=
MARKET_MCP_REQUEST_TIMEOUT_SECONDS=15

# --- trading-mcp, the tool server that moves the account --------------------------------
#
# Positions, balance and orders. Left unset, neither surface can see a position or send anything. No operator
# credential travels here — what guards it is that the account is a demo one, checked before the port opens.
TRADING_MCP_URL=http://127.0.0.1:8060
TRADING_MCP_SCOPE=
TRADING_MCP_REQUEST_TIMEOUT_SECONDS=35

# --- polymarket-data, the tool server that reads the prediction markets ------------------
#
# Nine tools: six read, three change the watch list. Left unset, neither surface can say what a market prices an
# event at — the state a deployment is in between the module going live and the operator's apply.
POLYMARKET_MCP_URL=http://127.0.0.1:8070
POLYMARKET_MCP_SCOPE=
POLYMARKET_MCP_REQUEST_TIMEOUT_SECONDS=35

# The fourth tool server, same shape as the three above and with the same supported absence: without it the
# conversation cannot say what was posted, and a team whose agents were assigned its tools refuses to run.
SOCIAL_MCP_URL=http://127.0.0.1:8090
SOCIAL_MCP_SCOPE=
SOCIAL_MCP_REQUEST_TIMEOUT_SECONDS=15

# The fifth, and the only one whose tools do something outside this system: sending a Telegram message.
# Absent, the conversation cannot notify anybody — the same supported state as the four above. The
# timeout is trading-mcp's number for trading-mcp's reason: giving up on this side of a message that was
# already delivered is a notification sent twice.
TELEGRAM_MCP_URL=http://127.0.0.1:8100
TELEGRAM_MCP_SCOPE=
TELEGRAM_MCP_REQUEST_TIMEOUT_SECONDS=35

# There is no TEAMS_MCP_URL any more, and a .env that still carries one is a .env from
# before this change: the team tools are a layer in this process, reached without a port.

# --- how long a run may take ------------------------------------------------------------
#
# The whole run, not one agent. The per-agent ceiling on model-tool rounds is not configurable and lives in the code,
# because a safety ceiling in a settings file is an invitation to raise it at the moment it is inconvenient.
RUN_TIMEOUT_SECONDS=900

# --- the teams surface's own clock -------------------------------------------------------
#
# A schedule firing from a task in this process's lifespan, not from anything in Azure. `false` turns it off without a
# redeploy, leaving every schedule where it is; the threshold is how many failed runs one tolerates before disabling itself.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_SECONDS=15
SCHEDULER_FAILURE_THRESHOLD=3

# Whether something stands in front of this process and authenticates callers (Easy Auth,
# in Azure). Off locally, where nothing stands in front and there is no identity to have.
REQUIRE_AUTHENTICATED_PRINCIPAL=false

# How much this process says. INFO by default; WARNING to turn it down without a deploy.
LOG_LEVEL=INFO
