# One process, two surfaces — and therefore one .env where there used to be three.
#
# The rule for reading this file: a name with a prefix is one of the four things that
# stay doubled on purpose (two schemas, two OpenAI keys, two model catalogues, and the
# conversation's default model). Everything else is one setting for the whole process.
# `workbench/config.py` is the only code that reads any of it.

# --- storage: two databases, one identity ---------------------------------------------
#
# Two logical databases in the local container from ../../compose.yaml (scripts/dev.py
# creates both on first run). They stay two: merging the data is a decision this change
# deliberately did not take.
#
# DATABASE_USER left unset is what selects local mode — without an identity, both
# surfaces' config.py refuse any remote host, production included. One value for both,
# because one App Service presents one managed identity. The remote shape (identity, TLS,
# no password in the URL) is production's, set by infra/app-service.tf.
AGENT_DATABASE_URL=postgresql://agent:change-me@127.0.0.1:55432/agent
TEAMS_DATABASE_URL=postgresql://teams:change-me@127.0.0.1:55432/teams
DATABASE_USER=

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# --- OpenAI: two keys, deliberately ----------------------------------------------------
#
# The key is the only credential either surface accepts — there is no managed-identity
# mode here the way there is for the database, because OpenAI is not in Entra and has
# nobody to present an Entra token to. Two of them so the cost of the team experiments
# shows up on its own line; in Azure they arrive as two Key Vault references
# (infra/key-vault.tf, `openai-api-key` and `teams-openai-api-key`).
AGENT_OPENAI_API_KEY=
TEAMS_OPENAI_API_KEY=

# --- the two catalogues ----------------------------------------------------------------
#
# `id` is this repository's own stable identifier (carried in every session, revision and
# usage row); `model` is what OpenAI is asked for, kept separate because an id outlives a
# model renamed or retired upstream. Rates are per 1,000,000 tokens — the unit OpenAI's own
# pricing page quotes, so a rate is copied across without arithmetic in either direction.
# Confirm current rates before deploying: they move faster than this module does. Confirm
# each `model` against `GET https://api.openai.com/v1/models` too — a name from memory
# fails at the first turn.
AGENT_MODELS=[{"id":"gpt-5.6-luna","model":"gpt-5.6-luna","display_name":"Luna","cost_rank":1,"input_rate_per_1m":"0.2","output_rate_per_1m":"1.2"},{"id":"gpt-5.6-terra","model":"gpt-5.6-terra","display_name":"Terra","cost_rank":2,"input_rate_per_1m":"2","output_rate_per_1m":"12"},{"id":"gpt-5.6-sol","model":"gpt-5.6-sol","display_name":"Sol","cost_rank":3,"input_rate_per_1m":"5","output_rate_per_1m":"30"}]

# The model a new conversation gets when the operator chooses none. MUST be one of the ids
# in AGENT_MODELS. There is no TEAMS_DEFAULT_MODEL_ID and there never was: every agent in a
# saved team revision names its own model, so there is no session to fall back for.
AGENT_DEFAULT_MODEL_ID=gpt-5.6-luna

TEAMS_MODELS=[{"id":"gpt-5.6-luna","model":"gpt-5.6-luna","display_name":"Luna","cost_rank":1,"input_rate_per_1m":"0.2","output_rate_per_1m":"1.2"},{"id":"gpt-5.6-terra","model":"gpt-5.6-terra","display_name":"Terra","cost_rank":2,"input_rate_per_1m":"2","output_rate_per_1m":"12"},{"id":"gpt-5.6-sol","model":"gpt-5.6-sol","display_name":"Sol","cost_rank":3,"input_rate_per_1m":"5","output_rate_per_1m":"30"}]

# --- market-data's tool surface, read by both -------------------------------------------
#
# The archive's read-only tools are a route of market-data itself (/mcp), which is why this
# points at 8020. Left unset, neither surface has archive tools: the conversation answers
# from the model alone, and a team whose agents assign tools is refused at run time rather
# than left to guess. MARKET_MCP_SCOPE is set only when the URL points off this machine
# (api://<market-data-app-id>/.default); a scope against loopback is refused at startup, and
# so is a remote URL without one.
MARKET_MCP_URL=http://127.0.0.1:8020
MARKET_MCP_SCOPE=
MARKET_MCP_REQUEST_TIMEOUT_SECONDS=15

# --- trading-mcp, the tool server that moves the account --------------------------------
#
# Positions, balance and working orders to read; orders to send, close, amend and cancel.
# Left unset, neither surface can see a position or send anything — a supported state, and
# configured independently of the archive above.
#
# No operator credential travels here: the account is one and shared, and trading-mcp reads
# no such header. What guards it is that the account is a demo one, checked by trading-mcp
# against the gateway before it opens a port at all. The timeout matches trading-mcp's own
# 30s ceiling on the gateway — a lower one here would time out this side of an order that
# had already been sent.
TRADING_MCP_URL=http://127.0.0.1:8060
TRADING_MCP_SCOPE=
TRADING_MCP_REQUEST_TIMEOUT_SECONDS=35

# --- polymarket-data, the tool server that reads the prediction markets ------------------
#
# Nine tools over the prediction-market archive: six read, three change the watch list.
# Left unset, neither surface can say what a market prices an event at — the state both
# were in before that module existed, and the one a deployment is in between the module
# going live and the operator's apply. Configured independently of the two above.
#
# Nothing here touches money: this system does not trade on Polymarket, and the three tools
# that write write a watch list. The timeout is trading-mcp's number for a different
# reason — `search_events` and `browse_events` ask Polymarket while the operator waits, and
# that module's own ceiling on the provider is 30s.
POLYMARKET_MCP_URL=http://127.0.0.1:8070
POLYMARKET_MCP_SCOPE=
POLYMARKET_MCP_REQUEST_TIMEOUT_SECONDS=35

# There is no TEAMS_MCP_URL any more, and a .env that still carries one is a .env from
# before this change: the team tools are a layer in this process, reached without a port.

# --- how long a run may take ------------------------------------------------------------
#
# The whole run, not one agent — several of them work in it, some at the same time. The
# per-agent ceiling on model-tool rounds is not configurable and lives in the code
# (teams/runner/loop.py), because a safety ceiling in a settings file is an invitation to
# raise it at the moment it is inconvenient.
RUN_TIMEOUT_SECONDS=900

# --- the teams surface's own clock -------------------------------------------------------
#
# A schedule or trigger firing on its own, from a task in this process's lifespan, not from
# anything in Azure. SCHEDULER_ENABLED=false turns it off without a redeploy: every schedule
# and trigger stays exactly where it was, and a run started by hand still works.
# SCHEDULER_FAILURE_THRESHOLD is how many consecutive failed runs a schedule or trigger
# tolerates before it disables itself.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_SECONDS=15
SCHEDULER_FAILURE_THRESHOLD=3

# Whether something stands in front of this process and authenticates callers (Easy Auth,
# in Azure). Off locally, where nothing stands in front and there is no identity to have.
REQUIRE_AUTHENTICATED_PRINCIPAL=false

# How much this process says. INFO by default; WARNING to turn it down without a deploy.
LOG_LEVEL=INFO
