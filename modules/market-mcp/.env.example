# Where market-data is listening. A host other than loopback needs MARKET_DATA_SCOPE —
# see config.py's mode switch.
MARKET_DATA_URL=http://127.0.0.1:8020

# Set only when MARKET_DATA_URL points off this machine — the scope this module's
# managed identity requests a token for, e.g. api://<market-data-app-id>/.default.
# Leave unset for local development.
MARKET_DATA_SCOPE=

MCP_HTTP_PORT=8040
MCP_REQUEST_TIMEOUT_SECONDS=10
